rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas para la colección historial-odontologia - PERMITIR LECTURA PÚBLICA
    match /historial-odontologia/{document} {
      allow read: if true;  // Cualquiera puede leer
      allow write: if request.auth != null;  // Solo escritura requiere auth
    }

    // Reglas para la coleccion historial-podologia
    match /historial-podologia/{document} {
      allow read: if true;  // Cualquiera puede leer
      allow write: if request.auth != null;  // Solo escritura requiere auth
    }

    // Reglas para la colección de usuarios
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas para la colección de recetas
    match /recetas/{recetaId} {
      allow read, write: if request.auth != null;
    }
    // Agrega aqui otras Reglas
  }
}