rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas para la colección de usuarios
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas para la colección historial
    match /historial-odontologia/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Reglas para la colección de recetas
    match /recetas/{recetaId} {
      allow read, write: if request.auth != null;
    }

    // Puedes añadir otras colecciones similares aquí
  }
}

service firebase.storage {
  match /b/{bucket}/o {
    // Permite acceso de lectura/escritura a todos los usuarios autenticados
    match /historial-odontologia/{docId}/adjuntos/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
